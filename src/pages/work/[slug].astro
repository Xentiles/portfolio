---
import Base from "../../layouts/Base.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import { work } from "../../i18n/work";
import { workSlugs } from "../../i18n/home";
const lang = "en";
const other = lang === "en" ? "sv" : "en";

export function getStaticPaths() {
  const lang = "en";
  const slug = (href: string) => href.split("/").filter(Boolean).pop()!;
  return work[lang].map((study) => ({ params: { slug: slug(workSlugs[lang][study.key]) }, props: { key: study.key } }));
}
const { key } = Astro.props as { key: "inspection" | "feedback" | "notchq" };
const list = work[lang];
const i = list.findIndex((s) => s.key === key);
const study = list[i];
const nextStudy = list[(i + 1) % list.length];
const back = (lang === "en" ? "/" : "/sv/") + "#work";
---
<Base lang={lang} path={workSlugs[lang][key]} alt={workSlugs[other][key]} title={study.title} description={study.lead}>
  <CaseStudy lang={lang} study={study} back={back} next={{ title: nextStudy.title, href: workSlugs[lang][nextStudy.key] }} />
</Base>

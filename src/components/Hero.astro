---
import { strings, type Lang } from "../i18n/strings";
interface Props { lang: Lang }
const t = strings[Astro.props.lang];
---
<section class="hero" aria-labelledby="name">
  <canvas id="orbit" aria-hidden="true"></canvas>
  <div class="hero-text">
    <h1 id="name" data-ink>{t.name}</h1>
    <p class="role" data-ink>{t.role}</p>
    <p class="thesis" data-ink>{t.thesis}</p>
  </div>
  <figure class="portrait" id="portrait" role="img" aria-label={t.portraitAlt}>
    <img id="pfpImg" alt="" src="/img/portrait.webp" width="1024" height="1536" decoding="async" />
  </figure>
</section>
